{
  "name": "cinema-booking-qa",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "dev:api": "npm run dev --workspace backend",
    "dev:web": "npm run dev --workspace frontend",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "env:compose": "node scripts/create-compose-env.mjs",
    "db:generate": "npm run db:generate --workspace backend",
    "db:migrate": "npm run db:migrate --workspace backend",
    "db:deploy": "npm run db:deploy --workspace backend",
    "db:seed": "npm run db:seed --workspace backend",
    "db:setup": "npm run db:up && npm run db:generate && npm run db:migrate && npm run db:seed",
    "test": "npm run test:api && npm run test:browser",
    "test:api": "npm run test --workspace backend && npm run test:worker-process --workspace backend",
    "test:worker-live": "npm run test:worker-live --workspace backend",
    "test:worker-soak": "npm run test:worker-soak --workspace backend",
    "test:browser": "playwright test",
    "test:browser:ui": "playwright test --ui",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "lint:openapi": "node scripts/lint-openapi.mjs",
    "scan:dast:api": "node scripts/run-dast-api.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "qa:trace": "node scripts/validate-traceability.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.3",
    "@playwright/test": "^1.55.0",
    "@redocly/cli": "^2.71.1",
    "concurrently": "^9.2.1"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
