{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "mutate": [
    "src/domain/booking-policy.ts",
    "src/domain/mock-payment-signature.ts"
  ],
  "coverageAnalysis": "perTest",
  "concurrency": 2,
  "timeoutMS": 30000,
  "thresholds": {
    "high": 80,
    "low": 70,
    "break": 70
  },
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": {
    "fileName": "../reports/generated/mutation/index.html"
  },
  "jsonReporter": {
    "fileName": "../reports/generated/mutation/mutation.json"
  },
  "vitest": {
    "configFile": "vitest.config.ts",
    "related": true
  }
}
